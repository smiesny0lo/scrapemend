# Copy to .env and fill in. Never commit .env.

# Identifiable User-Agent sent with every request (include a contact URL or email).
SPECMEND_USER_AGENT="specmend/0.1 (+https://example.com/contact)"

# Where raw response snapshots are stored (filesystem store).
SPECMEND_SNAPSHOT_DIR=./snapshots

# SQLite file for run history, baselines, anchors and spec versions.
SPECMEND_DB=specmend.db

# Where alerts go: stdout and/or log (space-separated). Empty means no alerts.
SPECMEND_NOTIFY=

# Repair provider: none | anthropic
SPECMEND_REPAIR_PROVIDER=none

# Only needed with the `anthropic` extra and SPECMEND_REPAIR_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Model for the anthropic provider (default: claude-opus-5-5).
SPECMEND_ANTHROPIC_MODEL=
