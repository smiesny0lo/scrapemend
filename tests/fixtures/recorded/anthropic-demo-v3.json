      "name": "reference",
      "strategies": [
        {
          "regex": "Ref\\.\\s*([A-Za-z0-9][A-Za-z0-9-]*)",
          "within": {
            "css": "div.max-w-3xl > h2 + div"
          }
        },
        {
          "regex": "Ref\\.\\s*([A-Z]{2}-\\d{4}-\\d+)",
          "within": null
        }
      ],
      "normalize": null,
      "date_format": null,
      "null_values": null
    },
